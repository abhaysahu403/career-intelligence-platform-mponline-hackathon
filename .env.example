# ═══════════════════════════════════════════════════════════════════════════
# Career Intelligence Platform - Environment Variables
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and update with your values
# ═══════════════════════════════════════════════════════════════════════════

# ─── Database ────────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USER=cip_user
DB_PASSWORD=cip_password_123
DB_NAME=career_intelligence

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT Authentication ──────────────────────────────────────────────────────
JWT_SECRET=cip-super-secret-jwt-key-minimum-256-bits-for-hs256-algorithm
JWT_EXPIRATION=86400

# ─── Anthropic Claude (REQUIRED for ML Service) ─────────────────────────────
# Get your API key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Model name Claude calls use — change here to trade cost vs quality
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ─── ML Service ──────────────────────────────────────────────────────────────
ML_SERVICE_URL=http://ml-service:8000

# ─── Frontend URLs ───────────────────────────────────────────────────────────
# These are baked into the browser bundle at build time (docker-compose passes
# them as build args to cip-web/Dockerfile) — set to the server's public
# domain/IP before deploying, not localhost, or every visitor's browser will
# try to call their own machine instead of the server.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_ML_URL=http://localhost:8000

# api-gateway CORS allowlist — set to the frontend's real HTTPS origin in production
FRONTEND_ORIGIN=http://localhost:3000

# ─── File Storage ────────────────────────────────────────────────────────────
STORAGE_TYPE=local
STORAGE_PATH=/app/storage
UPLOAD_MAX_SIZE=10485760

# ─── Spring Profiles ─────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=docker

# ─── Service Ports (Internal) ────────────────────────────────────────────────
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
STUDENT_SERVICE_PORT=8082
INTERVIEW_SERVICE_PORT=8083
RESUME_SERVICE_PORT=8084
CERTIFICATE_SERVICE_PORT=8085
JOB_SERVICE_PORT=8086
RECOMMENDATION_SERVICE_PORT=8087
SCORE_SERVICE_PORT=8088
ANALYTICS_SERVICE_PORT=8089
ML_SERVICE_PORT=8000
FRONTEND_PORT=3000
